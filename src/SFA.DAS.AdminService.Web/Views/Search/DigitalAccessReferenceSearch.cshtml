@using SFA.DAS.AdminService.Web.ViewModels.Search
@model DigitalAccessReferenceViewModel
@{
    ViewBag.Title = "Digital access reference number";
    Layout = "_Layout";
}

<a asp-action="Index" asp-controller="Dashboard" class="govuk-back-link">Back</a>

<main class="govuk-main-wrapper " id="main-content" role="main">
    <div class="govuk-grid-row">
        <div class="govuk-grid-column-two-thirds">
            @if (!ViewData.ModelState.IsValid)
            {
                <div class="govuk-error-summary" aria-labelledby="error-summary-title" role="alert" tabindex="-1" data-module="error-summary">
                    <h2 class="govuk-error-summary__title" id="error-summary-title">
                        There is a problem
                    </h2>
                    <div class="govuk-error-summary__body">
                        <ul class="govuk-list govuk-error-summary__list">
                            <li><a sfa-validation-for="ReferenceNumber"></a></li>
                        </ul>
                    </div>
                </div>
            }

            <form asp-action="DigitalAccessReferenceSearch" asp-controller="Search" method="post">
                <div class="govuk-form-group" sfa-validation-for="ReferenceNumber" sfa-validationerror-class="govuk-form-group--error">
                    <h1 class="govuk-label-wrapper">
                        <label class="govuk-label govuk-label--xl" for="ReferenceNumber">
                            Digital access reference number
                        </label>
                    </h1>
                    <span class="govuk-hint">Enter reference number for details of apprentice’s online journey</span>
                    <span class="govuk-error-message" asp-validation-for="ReferenceNumber"></span>
                    <input class="govuk-input" asp-for="ReferenceNumber" sfa-validation-for="ReferenceNumber" sfa-validationerror-class="govuk-input--error" id="ReferenceNumber" />
                </div>
                <button class="govuk-button" type="submit">Search reference number</button>
            </form>

            <p class="govuk-body"><a asp-action="Index" asp-controller="Search">Search standards and frameworks</a></p>

        </div>
    </div>
</main>
