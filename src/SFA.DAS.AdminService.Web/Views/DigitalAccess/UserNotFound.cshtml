@using SFA.DAS.AdminService.Web.ViewModels.DigitalAccess
@using SFA.DAS.AdminService.Web.Controllers
@model UserNotFoundViewModel
@{
    ViewBag.Title = "User not found";
    Layout = "_Layout";
}

<a asp-route="@DigitalAccessController.DigitalAccessReferenceSearchRouteGet" class="govuk-back-link">Back</a>

<main class="govuk-main-wrapper " id="main-content" role="main">
    <div class="govuk-grid-row">
        <div class="govuk-grid-column-two-thirds">
            
            <h1 class="govuk-heading-xl">
                <span class="govuk-caption-xl">Digital access reference: @Model.ReferenceNumber</span>
                User not matched
            </h1>

            <div class="govuk-inset-text app-inset-highlight">
                <p class="govuk-body-l govuk-!-margin-bottom-3 app-inset-highlight__heading">
                    This user does not exist in our records
                </p>
                <p class="govuk-body govuk-!-margin-bottom-0">
                    Advise them to contact their training provider.
                </p>
            </div>

            <h2 class="govuk-heading-m">User details</h2>

            <dl class="govuk-summary-list">
                <div class="govuk-summary-list__row">
                    <dt class="govuk-summary-list__key">First name</dt>
                    <dd class="govuk-summary-list__value">@Model.FirstName</dd>
                </div>
                <div class="govuk-summary-list__row">
                    <dt class="govuk-summary-list__key">Last name</dt>
                    <dd class="govuk-summary-list__value">@Model.LastName</dd>
                </div>
            </dl>

            <p class="govuk-body"><a asp-action="Index" asp-controller="Search">Search standards and frameworks</a></p>

        </div>
    </div>
</main>
